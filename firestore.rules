rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/classes/{classId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id', 'name', 'level', 'minutes', 'progress', 'updatedAt'])
        && request.resource.data.id == classId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.level in ['SL', 'HL']
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 10
        && request.resource.data.minutes <= 240
        && request.resource.data.progress is map;
    }
  }
}
